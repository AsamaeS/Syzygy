    ["esp:3V3", "ina219:VCC", "red", ["h0"]],
    ["esp:GND.2", "ina219:GND", "black", ["h0"]],
    ["esp:34", "pv_sim:SIG", "orange", ["h0"]],
    ["esp:35", "load_sim:SIG", "purple", ["h0"]],
    ["esp:25", "r1:1", "yellow", ["h0"]],
    ["r1:2", "led_status:A", "yellow", ["h0"]],
    ["led_status:C", "esp:GND.3", "black", ["h0"]],
    ["esp:26", "btn_fault:1.l", "white", ["h0"]],
    ["btn_fault:2.r", "esp:GND.1", "black", ["h0"]]
  ]
