{
  "version": 1,
  "author": "Syzygy Team",
  "editor": "wokwi",
  "parts": [
    {"type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {}},
    {"type": "wokwi-ina219", "id": "ina219", "top": 50, "left": 150, "attrs": {}},
    {"type": "wokwi-potentiometer", "id": "pv_sim", "top": -50, "left": -100, "attrs": {}},
    {"type": "wokwi-potentiometer", "id": "load_sim", "top": 50, "left": -100, "attrs": {}},
    {"type": "wokwi-resistor", "id": "r1", "top": 100, "left": 200, "attrs": {"value": "1000"}},
    {"type": "wokwi-led", "id": "led_status", "top": 150, "left": 100, "attrs": {"color": "green"}},
    {"type": "wokwi-pushbutton", "id": "btn_fault", "top": 200, "left": -50, "attrs": {}},
